    {
      "id": 21,
      "type": "timeseries",
      "title": "Jellyfin Host (emperor) CPU & Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{instance=~\"emperor.*\",mode=\"idle\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "CPU busy"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ds_prometheus"
          },
          "expr": "1 - (node_memory_MemAvailable_bytes{instance=~\"emperor.*\"} / node_memory_MemTotal_bytes{instance=~\"emperor.*\"})",
          "refId": "B",
          "legendFormat": "Memory used"
        }
      ]
    }
