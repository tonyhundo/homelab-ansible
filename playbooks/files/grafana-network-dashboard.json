{
  "uid": "network-overview",
  "title": "Network Overview - UniFi",
  "tags": ["network", "snmp", "unifi"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "uid": "ds_prometheus" },
        "query": "label_values(ifHCInOctets{job=\"snmp\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "ifName",
        "label": "Interface",
        "type": "query",
        "datasource": { "uid": "ds_prometheus" },
        "query": "label_values(ifHCInOctets{job=\"snmp\", instance=~\"$instance\"}, ifName)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Interface Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ifOperStatus" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "2": { "text": "DOWN", "color": "red" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ifHighSpeed" },
            "properties": [{ "id": "unit", "value": "Mbps" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "instance" }]
      },
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "ifName" } }
      ],
      "targets": [
        {
          "expr": "ifOperStatus{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}",
          "legendFormat": "{{instance}} - {{ifName}}",
          "format": "table",
          "instant": true
        },
        {
          "expr": "ifHighSpeed{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}",
          "legendFormat": "{{instance}} - {{ifName}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Traffic In (bits/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifHCInOctets{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval]) * 8",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Traffic Out (bits/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifHCOutOctets{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval]) * 8",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Packets In (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifInUcastPkts{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval])",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Packets Out (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifOutUcastPkts{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval])",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Errors In (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifInErrors{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval])",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Errors Out (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifOutErrors{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval])",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Discards In (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifInDiscards{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval])",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Discards Out (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(ifOutDiscards{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval])",
          "legendFormat": "{{instance}} - {{ifName}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Total Bandwidth by Device",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "datasource": { "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000000 },
              { "color": "red", "value": 100000000 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(ifHCInOctets{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval]) + rate(ifHCOutOctets{job=\"snmp\", instance=~\"$instance\", ifName=~\"$ifName\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
